{
	"schemaVersion": 1,
	"id": "bluewire",
	"version": "${version}",
	"name": "蓝色红石线",
	"description": "自定义红石粉静态颜色，并支持沿线路连续流动的动态 ARGB 渐变。",
	"authors": ["WalkerTian"],
	"contact": {
		"homepage": "https://github.com/Walkersifolia/",
		"sources": "https://github.com/Walkersifolia/Bluewire"
	},
	"license": "CC0-1.0",
	"icon": "assets/bluewire/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["com.bluewire.BluewireMod"],
		"client": ["com.bluewire.BluewireModClient"],
		"modmenu": ["com.bluewire.config.ModMenuIntegration"]
	},
	"mixins": [
		"bluewire.mixins.json",
		{
			"config": "bluewire.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": "*",
		"minecraft": "*",
		"java": "*",
		"fabric-api": "*"
	}
}
